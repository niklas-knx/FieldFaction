<?xml version="1.0" encoding="utf-8"?>
<!--
  In den physischen Pfad der IIS-Website/-Anwendung für FieldFaction legen (der Ordner
  selbst kann sonst leer sein — IIS braucht nur diese Datei, um Anfragen an den
  eigenständig laufenden Node-Prozess weiterzureichen).

  Voraussetzung: "URL Rewrite" + "Application Request Routing (ARR)" Module installiert,
  und im IIS-Manager am Server-Knoten unter "Application Request Routing Cache" →
  "Server Proxy Settings" → "Enable proxy" aktiviert (einmalig, serverweit).

  Port 3001 anpassen, falls PORT in server/.env abweicht.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="FieldFaction reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3001/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
