PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=dein_passwort
DB_NAME=fieldfaction
JWT_SECRET=min-64-zeichen-langer-zufaelliger-string-hier-eintragen
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173

# SMTP für Verifizierungs-E-Mails. Ohne SMTP_HOST werden Bestätigungslinks nur in die
# Server-Konsole geloggt statt verschickt — praktisch für lokale Entwicklung.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FieldFaction <no-reply@example.com>
